---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import AboutSection from "../components/AboutSection.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import KronikaTeasers from "../components/KronikaTeasers.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import Footer from "../components/Footer.astro";
import { turnaj } from "../data/turnaj";
import {
  organizaceSchema,
  webSchema,
  turnajSchema,
  breadcrumbSchema,
} from "../lib/schema";

const title = "Šachy Lysice – šachový turnaj 12. 12. 2026 pro každého";
const description =
  "Sousedské šachy v Lysicích na Blanensku. Turnaj pro začátečníky i matadory 12. 12. 2026 v Lysickém Jablíčku, vstup zdarma. Hrajeme pro radost.";
---

<BaseLayout
  title={title}
  description={description}
  ogImage={turnaj.obrazek}
  jsonLd={[organizaceSchema, webSchema, turnajSchema, breadcrumbSchema]}
>
  <Nav />

  <main>
    <Hero />
    <AboutSection />
    <UpcomingEvents />
    <KronikaTeasers />
  </main>

  <NewsletterSection />
  <Footer />
</BaseLayout>
